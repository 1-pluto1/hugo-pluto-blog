  author = {Liu, Chengwen and Yu, Xiaomin and Chang, Zhuoyue and Huang, Zhe and Zhang, Shuo and Lian, Heng and Wang, Kunyi and Xu, Rui and Hu, Sen and Hou, Jianheng and Peng, Hao and Qin, Chengwei and Hu, Xiaobin and Peng, Hong and Chen, Ronghao and Wang, Huacan},
  year = 2026,
