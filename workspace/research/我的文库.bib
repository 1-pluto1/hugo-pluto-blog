@misc{
  title = {Waypoint-{{Based Imitation Learning}} for {{Robotic Manipulation}}},
  author = {Shi, Lucy Xiaoyang and Sharma, Archit and Zhao, Tony Z. and Finn, Chelsea},
  year = 2023,
  month = jul,
  number = {arXiv:2307.14326},
  eprint = {2307.14326},
