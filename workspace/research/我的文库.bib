  shorttitle = {{{VLASH}}},
  author = {Tang, Jiaming and Sun, Yufei and Zhao, Yilong and Yang, Shang and Lin, Yujun and Zhang, Zhuoyang and Hou, James and Lu, Yao and Liu, Zhijian and Han, Song},
  year = 2025,
