@misc{
  title = {{{ACTLLM}}: {{Action Consistency Tuned Large Language Model}}},
  shorttitle = {{{ACTLLM}}},
  author = {Bi, Jing and Wen, Lianggong Bruce and Liu, Zhang and Xu, Chenliang},
