@misc{
  title = {Unified {{Reinforcement}} and {{Imitation Learning}} for {{Vision-Language Models}}},
  author = {Lee, Byung-Kwan and Hachiuma, Ryo and Ro, Yong Man and Wang, Yu-Chiang Frank and Wu, Yueh-Hua},
  year = 2025,
