  file = {/Users/yangchao/Zotero/storage/TMJWUVT7/Yu 等 - 2025 - Representation Alignment for Generation Training Diffusion Transformers Is Easier Than You Think.pdf;/Users/yangchao/Zotero/storage/3JQ7SCQS/2410.html}
