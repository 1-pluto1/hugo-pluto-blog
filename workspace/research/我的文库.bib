  keywords = {Computer Science - Robotics},
  annotation = {TLDR: E Evaluation results on multiple simulation platforms and robot embodiments show that FPC-VLA outperforms state-of-the-art models in both zero-shot and fine-tuned settings, and confirms FPC-VLA's strong generalization and practical utility for building more reliable autonomous systems.},
