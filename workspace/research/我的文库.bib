  author = {Yang, Yifan and Duan, Zhixiang and Xie, Tianshi and Cao, Fuyu and Shen, Pinxi and Song, Peili and Jin, Piaopiao and Sun, Guokang and Xu, Shaoqing and You, Yangwei and Liu, Jingtai},
  year = 2025,
