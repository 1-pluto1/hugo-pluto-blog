  shorttitle = {{{OmniSAT}}},
  author = {Lyu, Huaihai and Chen, Chaofan and Xie, Senwei and Wang, Pengwei and Chen, Xiansheng and Zhang, Shanghang and Xu, Changsheng},
  year = 2025,
