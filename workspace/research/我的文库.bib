  doi = {10.48550/arXiv.2312.08935},
  urldate = {2025-02-27},
  abstract = {In this paper, we present an innovative process-oriented math process reward model called \textbackslash textbf\textbraceleft Math-Shepherd\textbraceright, which assigns a reward score to each step of math problem solutions. The training of Math-Shepherd is achieved using automatically constructed process-wise supervision data, breaking the bottleneck of heavy reliance on manual annotation in existing work. We explore the effectiveness of Math-Shepherd in two scenarios: 1) \textbackslash textit\textbraceleft Verification\textbraceright : Math-Shepherd is utilized for reranking multiple outputs generated by Large Language Models (LLMs); 2) \textbackslash textit\textbraceleft Reinforcement Learning\textbraceright : Math-Shepherd is employed to reinforce LLMs with step-by-step Proximal Policy Optimization (PPO). With Math-Shepherd, a series of open-source LLMs demonstrates exceptional performance. For instance, the step-by-step PPO with Math-Shepherd significantly improves the accuracy of Mistral-7B (77.9\textbackslash\%\$\textbackslash to\$84.1\textbackslash\% on GSM8K and 28.6\textbackslash\%\$\textbackslash to\$33.0\textbackslash\% on MATH). The accuracy can be further enhanced to 89.1\textbackslash\% and 43.5\textbackslash\% on GSM8K and MATH with the verification of Math-Shepherd, respectively. We believe that automatic process supervision holds significant potential for the future evolution of LLMs.},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Computation and Language,Computer Science - Machine Learning},
  annotation = {TLDR: An innovative process-oriented math process reward model called Math-Shepherd, which assigns a reward score to each step of math problem solutions, which holds significant potential for the future evolution of LLMs.},
