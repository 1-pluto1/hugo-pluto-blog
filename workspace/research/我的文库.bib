  shorttitle = {{{UniCoD}}},
  author = {Zhang, Jianke and Hu, Yucheng and Guo, Yanjiang and Chen, Xiaoyu and Liu, Yichen and Chen, Wenna and Lu, Chaochao and Chen, Jianyu},
  year = 2025,
