  urldate = {2026-02-02},
  abstract = {Vision-language-action (VLA) models have shown remarkable capabilities in robotic manipulation, but their performance is sensitive to the \$\textbackslash textbf\textbraceleft action chunk length\textbraceright\$ used during training, termed \$\textbackslash textbf\textbraceleft horizon\textbraceright\$. Our empirical study reveals an inherent trade-off: longer horizons provide stronger global foresight but degrade fine-grained accuracy, while shorter ones sharpen local control yet struggle on long-term tasks, implying fixed choice of single horizons being suboptimal. To mitigate the trade-off, we propose a \$\textbackslash textbf\textbraceleft mixture of horizons (MoH)\textbraceright\$ strategy. MoH rearranges the action chunk into several segments with different horizons, processes them in parallel with a shared action transformer, and fuses outputs with a light linear gate. It has three appealing benefits. 1) MoH exploits long-term foresight and short-term precision jointly within a single model, improving both performance and generalizability to complex tasks. 2) MoH is plug-and-play for full-attention action modules with minimal training or inference overhead. 3) MoH enables dynamic inference with adaptive horizons, which selects stable actions through cross-horizon consensus, achieving 2.5\$\textbackslash times\$ higher throughput than baselines while preserving superior performance. Extensive experiments over flow-based policies \${$\pi\_$}0\$, \${$\pi\_$}\textbraceleft 0.5\textbraceright\$, and one-step regression policy \${$\pi\_$}\textbraceleft\textbackslash text\textbraceleft reg\textbraceright\textbraceright\$ demonstrate that MoH yields consistent and significant gains on both simulations and real-world tasks. Notably, under mixed-task setting, \${$\pi\_$}\textbraceleft 0.5\textbraceright\$ with MoH reaches a new state-of-the-art with 99\$\textbackslash\%\$ average success rate on LIBERO after only \$30k\$ training iterations. Project page: https://github.com/Timsty1/MixtureOfHorizons},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Computer Vision and Pattern Recognition,Computer Science - Robotics},
  annotation = {TLDR: Mixture of horizons exploits long-term foresight and short-term precision jointly within a single model, improving both performance and generalizability to complex tasks and enables dynamic inference with adaptive horizons.},
  note = {Comment: 15 pages, 14 figures},
  file = {/Users/yangchao/Zotero/storage/52VSWLPI/Jing 等 - 2025 - Mixture of Horizons in Action Chunking.pdf;/Users/yangchao/Zotero/storage/D2NGMIYP/2511.html}
}

@misc{
  title = {Unifying {{Perception}} and {{Action}}: {{A Hybrid-Modality Pipeline}} with {{Implicit Visual Chain-of-Thought}} for {{Robotic Action Generation}}},
  shorttitle = {Unifying {{Perception}} and {{Action}}},
  author = {Ma, Xiangkai and Xing, Lekai and Zhang, Han and Li, Wenzhong and Lu, Sanglu},
