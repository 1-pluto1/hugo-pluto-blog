}

@misc{
  title = {Unveiling the {{Potential}} of {{Vision-Language-Action Models}} with {{Open-Ended Multimodal Instructions}}},
  author = {Zhao, Wei and Li, Gongsheng and Gong, Zhefei and Ding, Pengxiang and Zhao, Han and Wang, Donglin},
  year = 2025,
