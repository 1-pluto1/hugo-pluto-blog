@misc{
  title = {A {{Survey}} on {{Efficient Vision-Language-Action Models}}},
  author = {Yu, Zhaoshu and Wang, Bo and Zeng, Pengpeng and Zhang, Haonan and Zhang, Ji and Gao, Lianli and Song, Jingkuan and Sebe, Nicu and Shen, Heng Tao},
