@misc{
  title = {What {{Do Latent Action Models Actually Learn}}?},
  author = {Zhang, Chuheng and Pearce, Tim and Zhang, Pushi and Wang, Kaixin and Chen, Xiaoyu and Shen, Wei and Zhao, Li and Bian, Jiang},
  year = 2025,
