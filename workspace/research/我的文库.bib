@misc{
  title = {{{WritingBench}}: {{A Comprehensive Benchmark}} for {{Generative Writing}}},
  shorttitle = {{{WritingBench}}},
  author = {Wu, Yuning and Mei, Jiahao and Yan, Ming and Li, Chenliang and Lai, Shaopeng and Ren, Yuran and Wang, Zijia and Zhang, Ji and Wu, Mengyue and Jin, Qin and Huang, Fei},
  year = 2025,
