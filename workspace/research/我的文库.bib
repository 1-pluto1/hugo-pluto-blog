@misc{
  title = {{{TwinVLA}}: {{Data-Efficient Bimanual Manipulation}} with {{Twin Single-Arm Vision-Language-Action Models}}},
  shorttitle = {{{TwinVLA}}},
  author = {Im, Hokyun and Jeong, Euijin and Fu, Jianlong and Kolobov, Andrey and Lee, Youngwoon},
