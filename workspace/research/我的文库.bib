  author = {Cheang, Chilam and Chen, Sijin and Cui, Zhongren and Hu, Yingdong and Huang, Liqun and Kong, Tao and Li, Hang and Li, Yifeng and Liu, Yuxiao and Ma, Xiao and Niu, Hao and Ou, Wenxuan and Peng, Wanli and Ren, Zeyu and Shi, Haixin and Tian, Jiawen and Wu, Hongtao and Xiao, Xin and Xiao, Yuyang and Xu, Jiafeng and Yang, Yichu},
  year = 2025,
