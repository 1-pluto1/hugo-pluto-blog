  shorttitle = {{{HiF-VLA}}},
  author = {Lin, Minghui and Ding, Pengxiang and Wang, Shu and Zhuang, Zifeng and Liu, Yang and Tong, Xinyang and Song, Wenxuan and Lyu, Shangke and Huang, Siteng and Wang, Donglin},
