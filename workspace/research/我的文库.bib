@misc{
  title = {Oryx {{MLLM}}: {{On-Demand Spatial-Temporal Understanding}} at {{Arbitrary Resolution}}},
  shorttitle = {Oryx {{MLLM}}},
  author = {Liu, Zuyan and Dong, Yuhao and Liu, Ziwei and Hu, Winston and Lu, Jiwen and Rao, Yongming},
