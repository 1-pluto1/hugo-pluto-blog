  file = {/Users/yangchao/Zotero/storage/Y2XN6MY3/Zheng 等 - 2025 - Spurious Forgetting in Continual Learning of Language Models.pdf;/Users/yangchao/Zotero/storage/MYMJKA47/2501.html}
