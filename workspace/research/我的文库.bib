  keywords = {Computer Science - Artificial Intelligence,Computer Science - Machine Learning,Computer Science - Robotics},
  annotation = {TLDR: This work proposes UniVLA, a new framework for learning cross-embodiment vision-language-action (VLA) policies that achieves superior performance over OpenVLA with less than 1/20 of pretraining compute and 1/10 of downstream data.},
