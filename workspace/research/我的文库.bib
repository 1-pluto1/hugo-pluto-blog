@misc{
  title = {{{EO-1}}: {{Interleaved Vision-Text-Action Pretraining}} for {{General Robot Control}}},
  shorttitle = {{{EO-1}}},
  author = {Qu, Delin and Song, Haoming and Chen, Qizhi and Chen, Zhaoqing and Gao, Xianqiang and Ye, Xinyi and Lv, Qi and Shi, Modi and Ren, Guanghui and Ruan, Cheng and Yao, Maoqing and Yang, Haoran and Bao, Jiacheng and Zhao, Bin and Wang, Dong},
  year = 2025,
