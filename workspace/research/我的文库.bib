  shorttitle = {{{FlowVLA}}},
  author = {Zhong, Zhide and Yan, Haodong and Li, Junfeng and Liu, Xiangchen and Gong, Xin and Zhang, Tianran and Song, Wenxuan and Chen, Jiayi and Zheng, Xinhu and Wang, Hesheng and Li, Haoang},
  year = 2025,
  month = oct,
  number = {arXiv:2508.18269},
  eprint = {2508.18269},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2508.18269},
  urldate = {2026-01-21},
  abstract = {Many Vision-Language-Action (VLA) models are built upon an internal world model trained via next-frame prediction ``\$v\_t \textbackslash rightarrow v\_\textbraceleft t+1\textbraceright\$''. However, this paradigm attempts to predict the future frame's appearance directly, without explicitly reasoning about the underlying dynamics. \textbackslash textbf\textbraceleft This lack of an explicit motion reasoning step\textbraceright{} often leads to physically implausible visual forecasts and inefficient policy learning. To address this limitation, we introduce the \textbackslash textbf\textbraceleft Visual Chain of Thought (Visual CoT)\textbraceright, a paradigm that compels the model to first reason about \textbackslash textbf\textbraceleft motion dynamics\textbraceright{} before generating the future frame. We instantiate this paradigm by proposing \textbackslash textbf\textbraceleft FlowVLA\textbraceright, an autoregressive Transformer that explicitly materializes this reasoning process as ``\$v\_t \textbackslash rightarrow f\_t \textbackslash rightarrow v\_\textbraceleft t+1\textbraceright\$'', where \$f\_t\$ is an intermediate optical flow prediction that inherently encodes motion. By forcing the model to first follow the motion plan encoded by \$f\_t\$, this process inherently \textbackslash textbf\textbraceleft aligns the pre-training objective of dynamics prediction with the downstream task of action generation.\textbraceright{} We conduct experiments on challenging robotics manipulation benchmarks, as well as real-robot evaluations. Our FlowVLA not only generates \textbackslash textbf\textbraceleft more coherent and physically plausible visual predictions\textbraceright, but also achieves state-of-the-art policy performance with \textbackslash textbf\textbraceleft substantially improved sample efficiency\textbraceright, pointing toward a more principled foundation for world modeling in VLAs. Project page: https://irpn-lab.github.io/FlowVLA/},
  archiveprefix = {arXiv},
  langid = {american},
  keywords = {Computer Science - Robotics},
  file = {/Users/yangchao/Zotero/storage/KVAC7YLS/Zhong 等 - 2025 - FlowVLA Visual Chain of Thought-based Motion Reasoning for Vision-Language-Action Models.pdf;/Users/yangchao/Zotero/storage/E32HAG8V/2508.html}
}

@misc{
  title = {{{DreamVLA}}: {{A Vision-Language-Action Model Dreamed}} with {{Comprehensive World Knowledge}}},
  shorttitle = {{{DreamVLA}}},
  author = {Zhang, Wenyao and Liu, Hongsi and Qi, Zekun and Wang, Yunnan and Yu, Xinqiang and Zhang, Jiazhao and Dong, Runpei and He, Jiawei and Lu, Fan and Wang, He and Zhang, Zhizheng and Yi, Li and Zeng, Wenjun and Jin, Xin},
  year = 2025,
