  author = {Xu, Chao and Zhang, Suyu and Liu, Yang and Sun, Baigui and Chen, Weihong and Xu, Bo and Liu, Qi and Wang, Juncheng and Wang, Shujun and Luo, Shan and Peters, Jan and Vasilakos, Athanasios V. and Zafeiriou, Stefanos and Deng, Jiankang},
  year = 2025,
