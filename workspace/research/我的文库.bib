}

@misc{
  title = {Breaking the {{Memory Wall}}: {{Exact Analytical Differentiation}} via {{Tiled Operator-Space Evolution}}},
  shorttitle = {Breaking the {{Memory Wall}}},
  author = {Wang, Shuhuan and Xie, Yuzhen and Li, Jiayi and Diao, Yinliang},
  year = 2025,
