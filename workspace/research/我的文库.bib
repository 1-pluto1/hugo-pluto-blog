@misc{
  title = {See {{Once}}, {{Then Act}}: {{Vision-Language-Action Model}} with {{Task Learning}} from {{One-Shot Video Demonstrations}}},
  shorttitle = {See {{Once}}, {{Then Act}}},
  author = {Chen, Guangyan and Wang, Meiling and Shao, Qi and Zhou, Zichen and Mao, Weixin and Cui, Te and Zhu, Minzhao and Deng, Yinan and Yang, Luojie and Zhang, Zhanqi and Yang, Yi and Chen, Hua and Yue, Yufeng},
