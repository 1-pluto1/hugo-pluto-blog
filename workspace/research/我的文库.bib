@misc{
  title = {Learning and {{Leveraging World Models}} in {{Visual Representation Learning}}},
  author = {Garrido, Quentin and Assran, Mahmoud and Ballas, Nicolas and Bardes, Adrien and Najman, Laurent and LeCun, Yann},
  year = 2024,
