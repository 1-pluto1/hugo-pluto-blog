@misc{
  title = {Visual {{Representation Alignment}} for {{Multimodal Large Language Models}}},
  author = {Yoon, Heeji and Jung, Jaewoo and Kim, Junwan and Choi, Hyungyu and Shin, Heeseong and Lim, Sangbeom and An, Honggyu and Kim, Chaehyun and Han, Jisang and Kim, Donghyun and Eom, Chanho and Hong, Sunghwan and Kim, Seungryong},
  year = 2025,
