@misc{
  title = {Language-{{Driven Representation Learning}} for {{Robotics}}},
  author = {Karamcheti, Siddharth and Nair, Suraj and Chen, Annie S. and Kollar, Thomas and Finn, Chelsea and Sadigh, Dorsa and Liang, Percy},
  year = 2023,
