  annotation = {TLDR: F-VLM simplifies the current multi-stage training pipeline by eliminating the need for knowledge distillation or detection-tailored pretraining, and observes that a frozen VLM: 1) retains the locality-sensitive features necessary for detection, and 2) is a strong region classifier.},
  note = {Comment: Accepted to ICLR 2023 (https://iclr.cc/Conferences/2023). 20 pages, 7 figures},
