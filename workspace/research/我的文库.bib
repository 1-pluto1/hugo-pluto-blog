  file = {/Users/yangchao/Zotero/storage/KHHHWDSV/Kim 等 - 2025 - Contrastive Representation Regularization for Vision-Language-Action Models.pdf;/Users/yangchao/Zotero/storage/B3U7QH8L/2510.html}
