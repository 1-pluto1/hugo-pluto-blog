  shorttitle = {{{ODYSSEY}}},
  author = {Wang, Kaijun and Lu, Liqin and Liu, Mingyu and Jiang, Jianuo and Li, Zeju and Zhang, Bolin and Zheng, Wancai and Yu, Xinyi and Chen, Hao and Shen, Chunhua},
  year = 2025,
  month = aug,
  number = {arXiv:2508.08240},
