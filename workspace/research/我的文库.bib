@misc{
  title = {Implicit {{Multimodal Alignment}}: {{On}} the {{Generalization}} of {{Frozen LLMs}} to {{Multimodal Inputs}}},
  shorttitle = {Implicit {{Multimodal Alignment}}},
  author = {Shukor, Mustafa and Cord, Matthieu},
  year = 2024,
  month = oct,
  number = {arXiv:2405.16700},
  eprint = {2405.16700},
  primaryclass = {cs},
