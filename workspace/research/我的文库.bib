  langid = {american},
  keywords = {Computer Science - Artificial Intelligence,Computer Science - Robotics},
  annotation = {TLDR: This survey delves into advanced VLA methods, aiming to provide a clear taxonomy and a systematic, comprehensive review of existing research, and presents a comprehensive analysis of VLA applications across different scenarios.},
