  keywords = {Computer Science - Artificial Intelligence,Computer Science - Computer Vision and Pattern Recognition},
  annotation = {TLDR: This work introduces the task of geo-localization as a novel evaluation metric to assess cultural diversity in VLMs and underscores the value of using diverse data to create more inclusive multimodal systems and lays the groundwork for developing VLMs that better represent global perspectives.},
