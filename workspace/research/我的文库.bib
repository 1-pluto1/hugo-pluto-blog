@misc{
  title = {{{XR-1}}: {{Towards Versatile Vision-Language-Action Models}} via {{Learning Unified Vision-Motion Representations}}},
  shorttitle = {{{XR-1}}},
  author = {Fan, Shichao and Wu, Kun and Che, Zhengping and Wang, Xinhua and Wu, Di and Liao, Fei and Liu, Ning and Zhang, Yixue and Zhao, Zhen and Xu, Zhiyuan and Li, Meng and Liu, Qingjie and Zhang, Shanghang and Wan, Min and Tang, Jian},
  year = 2025,
