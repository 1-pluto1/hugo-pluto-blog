  file = {/Users/yangchao/Zotero/storage/9SEI9CUD/Pai 等 - 2025 - mimic-video Video-Action Models for Generalizable  Robot Control Beyond VLAs.pdf;/Users/yangchao/Zotero/storage/327WXG7A/2512.html}
